---
// A real screenshot of yaah, captured in light and dark (see
// docs/experiments/2026-11-03-website/). Shows the capture for the current theme.
interface Props {
  name: string;
  alt: string;
  width: number;
  height: number;
  /** One capture for both themes (e.g. a screenshot of a VS Code theme). */
  single?: boolean;
  eager?: boolean;
  caption?: string;
  class?: string;
}
const { name, alt, width, height, single = false, eager = false, caption, class: className = "" } = Astro.props;
const loading = eager ? "eager" : "lazy";
---
<figure class:list={["min-w-0", className]}>
  <div class="overflow-hidden rounded-xl border bg-muted shadow-[0_1px_2px_rgb(0_0_0/0.04),0_8px_24px_-12px_rgb(0_0_0/0.12)] dark:shadow-[0_1px_2px_rgb(0_0_0/0.4),0_8px_24px_-12px_rgb(0_0_0/0.6)]">
    {single ? (
      <a href={`/shots/${name}.webp`} class="block rounded-xl focus-visible:-outline-offset-2" title="Open the full-size screenshot">
        <img src={`/shots/${name}.webp`} alt={alt} width={width} height={height} loading={loading} decoding="async" class="block h-auto w-full" />
      </a>
    ) : (
      <>
        <a href={`/shots/${name}-light.webp`} class="shot-light rounded-xl focus-visible:-outline-offset-2" title="Open the full-size screenshot">
          <img src={`/shots/${name}-light.webp`} alt={alt} width={width} height={height} loading={loading} decoding="async" class="block h-auto w-full" />
        </a>
        <a href={`/shots/${name}-dark.webp`} class="shot-dark rounded-xl focus-visible:-outline-offset-2" title="Open the full-size screenshot">
          <img src={`/shots/${name}-dark.webp`} alt={alt} width={width} height={height} loading={loading} decoding="async" class="block h-auto w-full" />
        </a>
      </>
    )}
  </div>
  {caption && <figcaption class="mt-2.5 text-[13px] leading-5 text-muted-foreground">{caption}</figcaption>}
</figure>
